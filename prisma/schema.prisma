// Social Media Manager - Prisma schema
// Postgres relational schema for tasks, profiles, users, analytics and notifications.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
}

enum TaskStatus {
  PLANNED
  TODO
  PUBLISHED
  OVERDUE
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  TASK_PUBLISHED
  SYSTEM
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(WORKER)
  telegramChatId String?
  active         Boolean  @default(true)
  bonusPoints    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedTasks     ContentTask[]      @relation("AssignedTasks")
  notifications     Notification[]
  pointsAdjustments PointsAdjustment[]

  @@index([role])
}

/** A single admin-issued points penalty/bonus with a reason, kept as a log (not overwritten). */
enum AdjustmentStatus {
  APPROVED
  PENDING
  REJECTED
}

model PointsAdjustment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int
  reason String

  /** True when the worker requested this themselves (extra-effort bonus); false for admin-issued penalties, which are always pre-decided. */
  requestedByWorker Boolean          @default(false)
  status            AdjustmentStatus @default(APPROVED)

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([userId])
  @@index([status])
}

model Profile {
  id                 String   @id @default(cuid())
  name               String
  instagramUsername  String?
  imageUrl           String?
  color              String   @default("#6366f1")
  notes              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tasks ContentTask[]

  @@index([active])
}

model ContentTask {
  id             String     @id @default(cuid())
  profileId      String
  profile        Profile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  assignedUserId String?
  assignedUser   User?      @relation("AssignedTasks", fields: [assignedUserId], references: [id], onDelete: SetNull)

  title   String
  topic   String?
  brief   String?
  caption String?

  deadlineAt DateTime
  status     TaskStatus @default(PLANNED)

  /** Admin-granted exception letting the worker self-publish this task even though it's OVERDUE. */
  lateSubmissionAllowed Boolean @default(false)

  adminNotes    String?
  workerNotes   String?
  attachmentUrl String?
  instagramUrl  String?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analytics Analytics?

  @@index([deadlineAt])
  @@index([status])
  @@index([profileId])
  @@index([assignedUserId])
  @@index([createdAt])
}

model Analytics {
  id     String      @id @default(cuid())
  taskId String      @unique
  task   ContentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  views           Int @default(0)
  reach           Int @default(0)
  likes           Int @default(0)
  comments        Int @default(0)
  shares          Int @default(0)
  saves           Int @default(0)
  followersGained Int @default(0)

  updatedAt DateTime @updatedAt
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  taskId  String?
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model AppSettings {
  id               String   @id @default("singleton")
  telegramBotToken String?
  timezone         String   @default("Europe/Bratislava")

  /** Dashboard "Po termíne" only counts overdue tasks whose deadline is after this point; underlying tasks are untouched. */
  overdueStatsResetAt DateTime?

  updatedAt DateTime @updatedAt
}
