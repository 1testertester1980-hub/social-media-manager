# PostgreSQL connection string (use Vercel Postgres / Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/social_media_manager?schema=public"

# Secret used to sign Auth.js JWTs/cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Telegram bot notifications (optional). Leave empty to disable Telegram notifications.
# Create a bot with @BotFather to get a token.
TELEGRAM_BOT_TOKEN=""
# Default worker chat id used as a fallback if a user has no telegramChatId set.
TELEGRAM_WORKER_CHAT_ID=""

# Public URL of the deployed app, used to build links inside Telegram messages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: protects the /api/cron/sync-overdue endpoint. Set the same value
# as a Vercel Cron secret if you want to restrict who can trigger it manually.
CRON_SECRET=""
